{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint",
    "format": "prettier --write src tests playwright.config.ts vite.config.ts",
    "check": "prettier --check src tests playwright.config.ts vite.config.ts",
    "typecheck": "tsc --noEmit",
    "start": "node .output/server/index.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:integration": "playwright test --config playwright.integration.config.ts && node tests/built-crypto.mjs && node tests/native-smoke.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/geist": "5.3.0",
    "@hugeicons/core-free-icons": "4.3.5",
    "@hugeicons/react": "1.1.10",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.2",
    "@tanstack/react-router": "1.170.44",
    "@tanstack/react-start": "1.169.1",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "nitro": "3.0.260903-beta",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "4.21.4",
    "tailwindcss": "4.3.3",
    "teleproto": "1.230.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tanstack/eslint-config": "0.4.0",
    "@tanstack/router-cli": "1.167.43",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  }
}
