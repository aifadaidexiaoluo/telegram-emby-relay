# TanStack Start 单服务环境；真实值只保存到 management.env（0600）。
TG_API_ID=0
TG_API_HASH=
# 可直接在设置页填写 Emby 地址与 API Key；以下环境值只作默认值。
EMBY_API_KEY=
EMBY_BASE_URL=http://emby:8096/emby
WEB_ORIGIN=http://localhost:3000
WEB_PORT=3000
MEDIA_PATH=./local-data/media
TEMP_PATH=./local-data/temp
# 迁移旧状态卷前必须停止旧下载器并备份。
TELEGRAM_STATE_VOLUME=relay_state
CONFIG_VOLUME=relay_configuration
EMBY_NETWORK=emby_media_internal
